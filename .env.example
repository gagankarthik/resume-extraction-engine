# Provider: "openai" or "anthropic"
MODEL_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (only needed if MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Pipeline mode: true = multi-agent (higher accuracy), false = single-shot (faster)
USE_ORCHESTRATOR=true

# Upload size limit in MB
MAX_FILE_SIZE_MB=20

# ── Upload authorisation ──────────────────────────────────────────────────────
# The browser posts resumes straight to this service — the pipeline takes
# 30-90s and no proxy in front of it will hold a connection that long — so the
# service authorises its own callers rather than trusting a gateway to do it.
#
# The frontend signs a short-lived ticket with this secret and the engine
# verifies it. Must match NEXT_EXTRACTION_SHARED_SECRET in the frontend exactly.
# Generate with: openssl rand -hex 32
EXTRACTION_SHARED_SECRET=

# Uploads are REFUSED while the secret above is empty. To run locally without
# one, opt out explicitly. Never set this in a deployed environment.
# EXTRACTION_ALLOW_ANONYMOUS=true

# Browser origins allowed to call /extract, comma-separated. This is read only
# outside Lambda — in production the Function URL answers CORS and the app skips
# its own middleware, so the list that matters there is terraform's
# allowed_origins. Keep the two in step for a local run of the same image.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
